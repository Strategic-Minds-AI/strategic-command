{
  "description": "Every five minutes, enqueue due enabled schedules. This does not execute computer actions. Requires available automation credits.",
  "name": "Operator Queue Tick",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "operator_queue_tick",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enqueue_due_tasks": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enqueueOperatorSchedules",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Queue due tasks",
            "description": "Add scheduled goals to the task queue"
          }
        }
      }
    ]
  }
}